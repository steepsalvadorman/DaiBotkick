# Credenciales de tu aplicación OAuth de Kick.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# PostgreSQL independiente para desarrollo; producción requiere almacenamiento persistente.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daibot
BASE_URL=http://localhost:3000
PORT=3000
OVERLAY_DIR=../overlay
# Si se omite, usa un directorio temporal del sistema, también en Windows.
# TTS_CACHE_DIR=
# Clave API de Fish Audio (solo necesaria para el comando !jacinta).
FISH_AUDIO_API_KEY=
RUST_LOG=info

# Opcional: playlists de YouTube. Restringe la clave a YouTube Data API.
# YOUTUBE_API_KEY=
# Opcional: ruta absoluta a yt-dlp si no esta en PATH (busqueda por nombre).
# YT_DLP_PATH=

# Las respuestas por canal (cmd_discord, cmd_redes, cmd_pc, cmd_horario,
# follow_goal) se guardan en la tabla channels; no se leen de este .env.
# Los tokens de acceso, panel y reproducción se generan mediante /auth/kick.
# Para probar webhooks localmente usa HTTPS público y configura BASE_URL,
# redirect /auth/callback y webhook /kick_webhook con esa misma URL.
# Para los cartones privados autoriza también /auth/bingo/callback en Kick.

# Desarrollo local con ./dev.sh (túnel HTTPS para los webhooks de Kick).
# Con una URL fija configuras la app de Kick una sola vez:
# NGROK_DOMAIN=tu-dominio.ngrok-free.app
# o bien un túnel con nombre de cloudflared en tu dominio:
# CF_TUNNEL_NAME=daibot-dev
# CF_TUNNEL_URL=https://dev.tudominio.com
# Sin ninguno, usa un túnel rápido de cloudflared (la URL cambia cada vez).

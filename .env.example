# Credenciales de tu aplicación OAuth de Kick.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# PostgreSQL independiente para desarrollo; producción requiere almacenamiento persistente.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/daibot
BASE_URL=http://localhost:3000
PORT=3000
OVERLAY_DIR=../overlay
# Si se omite, usa un directorio temporal del sistema, también en Windows.
# TTS_CACHE_DIR=
RUST_LOG=info

# Opcional: playlists de YouTube. Restringe la clave a YouTube Data API.
# YOUTUBE_API_KEY=

# Las respuestas por canal (cmd_discord, cmd_redes, cmd_pc, cmd_horario,
# follow_goal) se guardan en la tabla channels; no se leen de este .env.
# Los tokens de acceso, panel y reproducción se generan mediante /auth/kick.
# Para probar webhooks localmente usa HTTPS público y configura BASE_URL,
# redirect /auth/callback y webhook /kick_webhook con esa misma URL.
